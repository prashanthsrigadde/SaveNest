{
  "name": "SaveNest \u2014 Your Personal Content Library",
  "short_name": "SaveNest",
  "start_url": "./?source=pwa",
  "display": "standalone",
  "background_color": "#0d0f14",
  "theme_color": "#17152e",
  "description": "Save, organize and quickly find Instagram, YouTube and web content by category.",
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    },
    "enctype": "application/x-www-form-urlencoded"
  },
 
"icons": [
  {
    "src": "./icon-192.png",
    "sizes": "192x192",
    "type": "image/png"
  },
  {
    "src": "./icon-512.png",
    "sizes": "512x512",
    "type": "image/png"
  }
],
  "id": "./",
  "scope": "./",
  "display_override": [
    "standalone",
    "minimal-ui"
  ]
}
